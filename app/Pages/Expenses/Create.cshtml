@page
@model CreateModel
@{
    ViewData["Title"] = "Create Expense";
}

<div class="card">
    <div class="card-header">
        <h1 class="card-title">Create New Expense</h1>
        <a asp-page="/Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success">@Model.Message</div>
    }

    <form method="post">
        <div class="form-group">
            <label class="form-label" asp-for="NewExpense.UserId">Employee</label>
            <select asp-for="NewExpense.UserId" class="form-control">
                @foreach (var user in Model.Users)
                {
                    <option value="@user.UserId">@user.UserName (@user.Email)</option>
                }
            </select>
            <span asp-validation-for="NewExpense.UserId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="NewExpense.CategoryId">Category</label>
            <select asp-for="NewExpense.CategoryId" class="form-control">
                @foreach (var category in Model.Categories)
                {
                    <option value="@category.CategoryId">@category.CategoryName</option>
                }
            </select>
            <span asp-validation-for="NewExpense.CategoryId" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="NewExpense.Amount">Amount (£)</label>
            <input asp-for="NewExpense.Amount" class="form-control" type="number" step="0.01" min="0.01" />
            <span asp-validation-for="NewExpense.Amount" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="NewExpense.ExpenseDate">Expense Date</label>
            <input asp-for="NewExpense.ExpenseDate" class="form-control" type="date" />
            <span asp-validation-for="NewExpense.ExpenseDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="NewExpense.Description">Description</label>
            <textarea asp-for="NewExpense.Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="NewExpense.Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label class="form-label" asp-for="NewExpense.ReceiptFile">Receipt File Path (Optional)</label>
            <input asp-for="NewExpense.ReceiptFile" class="form-control" type="text" placeholder="/receipts/filename.jpg" />
            <span asp-validation-for="NewExpense.ReceiptFile" class="text-danger"></span>
        </div>

        <div style="display: flex; gap: 1rem;">
            <button type="submit" class="btn btn-primary">Create Expense</button>
            <a asp-page="/Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
